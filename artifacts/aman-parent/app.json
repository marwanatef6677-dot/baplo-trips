{
  "expo": {
    "name": "أمان — رقابة أبوية شفافة",
    "slug": "aman-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aman-parent",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5F8F5",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
